GEMINI_API_KEY=pega_aqui_tu_clave
# Opcional: la app elige sola los modelos gratuitos disponibles para tu clave.
# GEMINI_MODEL=gemini-3.5-flash          # fuerza este modelo como primera opción
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite   # reemplaza la lista de preferencia
# GEMINI_RETRIES=3          # intentos por modelo ante 503/5xx
# GEMINI_RETRY_DELAY=1.5    # espera base en segundos (se duplica en cada reintento)
# APP_NAME=Principia
# PORT=5000
